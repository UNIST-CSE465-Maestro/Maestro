{
  "schema_version": 1,
  "policy_id": "maestro_app_ks_update_policy_v1",
  "status": "draft_from_current_app_logic",
  "last_reviewed": "2026-05-28",
  "purpose": "Define how Maestro app-level knowledge state is updated from study events and partial MIKT pred_correct evidence.",
  "state_model": {
    "owner": "maestro_app",
    "score_name": "mastery",
    "score_range": {
      "min": 0.0,
      "max": 1.0
    },
    "confidence_range": {
      "min": 0.0,
      "max": 1.0
    },
    "stores_mikt_internal_skill_state": false,
    "uses_mikt_pred_correct_as_partial_signal": true,
    "primary_units": [
      "concept",
      "document_concept",
      "document"
    ]
  },
  "current_code_references": {
    "event_store": "app/app/src/main/java/com/maestro/app/data/local/StudyEventLocalDataSource.kt",
    "heuristic_tracer": "app/app/src/main/java/com/maestro/app/data/service/HeuristicKnowledgeTracer.kt",
    "mikt_onnx_tracer": "app/app/src/main/java/com/maestro/app/data/service/OnnxMiktKnowledgeTracer.kt",
    "dashboard_aggregation": "app/app/src/main/java/com/maestro/app/data/repository/KnowledgeRepositoryImpl.kt",
    "viewer_event_recording": "app/app/src/main/java/com/maestro/app/ui/viewer/ViewerViewModel.kt"
  },
  "current_implementation": {
    "empty_event_result": {
      "mastery": 0.0,
      "confidence": 0.0
    },
    "heuristic_fallback": {
      "initial_mastery_when_events_exist": 0.18,
      "score_clamp_after_each_event": true,
      "confidence_formula": "min(1.0, evidence_sum / 8.0)",
      "event_effects": {
        "DOCUMENT_OPENED": {
          "mastery_delta": 0.02,
          "evidence_delta": 0.4
        },
        "PAGE_VIEWED": {
          "mastery_delta": 0.015,
          "evidence_delta": 0.3
        },
        "BOOKMARK_TOGGLED": {
          "mastery_delta": 0.015,
          "evidence_delta": 0.25
        },
        "ANNOTATION_SAVED": {
          "mastery_delta": 0.025,
          "evidence_delta": 0.45
        },
        "LLM_REQUESTED": {
          "mastery_delta": 0.035,
          "evidence_delta": 0.65
        },
        "QUIZ_REQUESTED": {
          "mastery_delta": 0.04,
          "evidence_delta": 0.75
        },
        "QUIZ_ANSWERED_CORRECT": {
          "mastery_delta": 0.16,
          "evidence_delta": 1.25
        },
        "QUIZ_ANSWERED_INCORRECT": {
          "mastery_delta": -0.08,
          "evidence_delta": 1.25
        }
      }
    },
    "mikt_onnx_behavior": {
      "active_when_file_exists": "mikt_mobile.onnx",
      "contract_file": "mikt_contract.json",
      "events_used_for_sequence": [
        "QUIZ_ANSWERED"
      ],
      "ignores_non_quiz_events_in_model_sequence": true,
      "raw_sequence_window": "contract.rawSequenceLength, default 200",
      "default_input_sequence_length": 199,
      "confidence_formula": "clamp(quiz_answered_count / 8.0, 0.2, 1.0)",
      "preferred_output": "last_prediction",
      "fallback_output": "prediction_sequence[last_valid_index]",
      "current_mastery_mapping": "ONNX prediction is currently returned as KnowledgeTraceResult.mastery when model inference succeeds.",
      "fallback_on_error": "HeuristicKnowledgeTracer"
    },
    "quiz_sidebar_mastery": {
      "default_without_answers": 0.35,
      "formula_with_answers": "correct_quiz_answers_for_document / total_quiz_answers_for_document",
      "usage": "Used to select quiz Bloom level and to log prediction error before answer."
    }
  },
  "target_hybrid_policy": {
    "summary": "App-level KS remains the source of truth. Study events update KS directly, and MIKT pred_correct only nudges KS toward the model estimate.",
    "event_update": {
      "base": "Use current heuristic event_effects as default app interaction weights.",
      "apply_order": [
        "start from previous app mastery, or initial_mastery_when_events_exist for first evidence",
        "apply event mastery_delta",
        "clamp mastery to [0.0, 1.0]",
        "add evidence_delta",
        "compute confidence as min(1.0, evidence_sum / 8.0)"
      ]
    },
    "mikt_pred_correct_update": {
      "applies_to_event": "QUIZ_ANSWERED",
      "expected_model_signal": "pred_correct_before_response",
      "meaning": "Probability that the student would answer the current question correctly given prior quiz history and question features.",
      "blend_formula": "mastery_after = clamp(mastery_after_event + model_weight * model_confidence * (pred_correct - mastery_after_event), 0.0, 1.0)",
      "default_model_weight": 0.25,
      "max_abs_model_adjustment_per_quiz": 0.08,
      "model_confidence_source": "MIKT sequence confidence, default clamp(quiz_answered_count / 8.0, 0.2, 1.0)",
      "rationale": "Correctness remains the strongest local evidence, but MIKT can soften overreaction to one answer and calibrate KS using history-aware prediction."
    },
    "quiz_answer_event_policy": {
      "correct_delta": 0.16,
      "incorrect_delta": -0.08,
      "evidence_delta": 1.25,
      "optional_modifiers": {
        "bloom_level_multiplier": {
          "1": 0.85,
          "2": 0.95,
          "3": 1.0,
          "4": 1.08,
          "5": 1.15,
          "6": 1.2
        },
        "response_time_multiplier": {
          "fast_correct": 1.05,
          "normal": 1.0,
          "very_slow_correct": 0.9,
          "fast_incorrect": 1.1
        }
      }
    },
    "non_quiz_study_event_policy": {
      "DOCUMENT_OPENED": {
        "role": "weak exposure evidence",
        "mastery_delta": 0.02
      },
      "PAGE_VIEWED": {
        "role": "weak reading evidence",
        "mastery_delta": 0.015
      },
      "BOOKMARK_TOGGLED": {
        "role": "weak intent or review evidence",
        "mastery_delta": 0.015
      },
      "ANNOTATION_SAVED": {
        "role": "active processing evidence",
        "mastery_delta": 0.025
      },
      "LLM_REQUESTED": {
        "role": "question asking or clarification evidence",
        "mastery_delta": 0.035
      },
      "QUIZ_REQUESTED": {
        "role": "self-testing intent evidence",
        "mastery_delta": 0.04
      }
    },
    "aggregation_policy": {
      "concept_mastery": "Trace all events linked to concept id or documents assigned to that concept.",
      "document_concept_mastery": "Trace events for one document and one concept.",
      "document_mastery": "Average document_concept mastery values.",
      "overall_average_mastery": "Average document mastery and concept mastery values."
    },
    "question_encoder_flow": {
      "on_quiz_generation": [
        "send generated question text, choices, optional visual context, and concept metadata to question encoder server",
        "receive and locally store question embedding, difficulty, and QE metadata"
      ],
      "on_user_answer": [
        "combine stored question embedding, concept ids, previous quiz history, and user response",
        "run local MIKT ONNX inference",
        "apply app event update",
        "apply partial pred_correct blend"
      ]
    }
  },
  "implementation_notes": {
    "do_not_require": [
      "persistent MIKT skill_state",
      "initial_state.json",
      "tap_readout.onnx"
    ],
    "required_before_enabling_hybrid_runtime": [
      "MIKT ONNX contract that exposes pred_correct_before_response or an equivalent last_prediction",
      "QE server response stored with each generated quiz question",
      "app code change so OnnxMiktKnowledgeTracer returns model_signal separately instead of replacing app mastery"
    ]
  }
}
